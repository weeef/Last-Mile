class_name GameAudio
extends Node
## Music and sound effects. One instance lives under main; everything else uses
## the static helpers (GameAudio.sfx("click"), GameAudio.music("day")), which do
## nothing when no instance exists (headless tests).
##
## All audio is original and generated by tools/make_audio.py.

const MUSIC := {
	"title": "res://audio/music/title.ogg",   # Maple St. at Dawn
	"desk": "res://audio/music/desk.ogg",     # Dispatch Desk (briefing, evening)
	"day": "res://audio/music/day.ogg",       # Out for Delivery
	"peak": "res://audio/music/peak.ogg",     # Holiday Peak (boss and peak days)
}
const SFX := ["click", "card", "coin", "stamp", "event", "ding", "late", "cash", "jackpot", "bust", "streak",
	"streak_break", "breakdown", "rush", "notice", "power", "depart", "rent_paid", "win", "evicted", "level_up", "relic"]
const VOICES := 12
const FADE := 1.2
const MIN_GAP_MS := 45          # the same sound can't stack faster than this (8x speed)

static var instance: GameAudio

var music_volume := 0.6
var sfx_volume := 0.8
var _sfx := {}
var _music := {}
var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _last := {}
var _a: AudioStreamPlayer
var _b: AudioStreamPlayer
var _current := ""
var _fade: Tween


func _ready() -> void:
	instance = self
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	_a = AudioStreamPlayer.new()
	_b = AudioStreamPlayer.new()
	add_child(_a)
	add_child(_b)
	for n in SFX:
		var s := _load("res://audio/sfx/%s.ogg" % n)
		if s:
			_sfx[n] = s


func _exit_tree() -> void:
	if instance == self:
		instance = null


## Imported resource if the editor has imported it, else the raw .ogg file.
static func _load(path: String) -> AudioStream:
	if ResourceLoader.exists(path):
		var s = load(path)
		if s is AudioStream:
			return s
	if FileAccess.file_exists(path):
		return AudioStreamOggVorbis.load_from_file(path)
	return null


# ------------------------------------------------------------- static helpers

static func sfx(n: String, pitch := 1.0, volume_db := 0.0) -> void:
	if instance:
		instance.play(n, pitch, volume_db)


static func music(track: String) -> void:
	if instance:
		instance.play_music(track)


# ------------------------------------------------------------- playback

func play(n: String, pitch := 1.0, volume_db := 0.0) -> void:
	if not _sfx.has(n) or sfx_volume <= 0.0:
		return
	var now := Time.get_ticks_msec()
	if now - int(_last.get(n, -1000)) < MIN_GAP_MS:
		return
	_last[n] = now
	var p := _players[_next]
	_next = (_next + 1) % _players.size()
	p.stream = _sfx[n]
	p.pitch_scale = clampf(pitch, 0.25, 4.0)
	p.volume_db = volume_db + linear_to_db(sfx_volume)
	p.play()


func play_music(track: String) -> void:
	if track == _current:
		return
	_current = track
	var stream: AudioStream = _music.get(track)
	if stream == null and MUSIC.has(track):
		stream = _load(MUSIC[track])
		if stream is AudioStreamOggVorbis:
			(stream as AudioStreamOggVorbis).loop = true
		_music[track] = stream
	# Crossfade: the idle player takes the new track.
	var outgoing := _a
	var incoming := _b
	if _b.playing and not _a.playing:
		outgoing = _b
		incoming = _a
	_a = incoming
	_b = outgoing
	if _fade and _fade.is_valid():
		_fade.kill()          # a quick second switch must not stop the reused player
	var tw := create_tween()
	_fade = tw
	tw.set_parallel(true)
	if outgoing.playing:
		tw.tween_property(outgoing, "volume_db", -60.0, FADE)
	if stream != null:
		incoming.stream = stream
		incoming.volume_db = -60.0
		incoming.play()
		tw.tween_property(incoming, "volume_db", _music_db(), FADE)
	tw.chain().tween_callback(outgoing.stop)


func set_volumes(p_music: float, p_sfx: float) -> void:
	music_volume = p_music
	sfx_volume = p_sfx
	if _a.playing:
		_a.volume_db = _music_db()


func _music_db() -> float:
	return linear_to_db(maxf(music_volume, 0.0001)) - 4.0

class_name GameAudio
extends Node
## Music, sound effects and ambience on their own buses (Master > Music,
## Effects, Ambience) so each has a volume slider. One instance lives under
## main; everything else uses the static helpers (GameAudio.sfx("click"),
## GameAudio.music("day")), which do nothing when no instance exists
## (headless tests).
##
## All audio is original and generated by tools/make_audio.py (CC0).

const MUSIC := {
	"title": "res://audio/music/title.ogg",   # Maple St. at Dawn
	"desk": "res://audio/music/desk.ogg",     # Dispatch Desk (briefing, evening)
	"day": "res://audio/music/day.ogg",       # Out for Delivery
	"peak": "res://audio/music/peak.ogg",     # Holiday Peak (boss and peak days)
}
const AMBIENCE := {
	"day": "res://audio/ambience/day.ogg",
	"night": "res://audio/ambience/night.ogg",
	"rain": "res://audio/ambience/rain.ogg",
}
const ENGINE := "res://audio/ambience/engine.ogg"
const SFX := ["click", "confirm", "card", "reveal", "ultra", "coin", "stamp", "event", "ding", "late", "doorbell", "cash",
	"jackpot", "bust", "streak", "streak_break", "breakdown", "tow", "rush", "notice", "power", "depart", "rent_paid",
	"win", "evicted", "level_up", "relic", "phone"]
const BUSES := ["Music", "Effects", "Ambience"]
const VOICES := 12
const FADE := 1.2
const MIN_GAP_MS := 45          # the same sound can't stack faster than this (8x speed)
const MAX_PER_FRAME := 3        # fast-forward can fire dozens of events in one frame

static var instance: GameAudio

var _sfx := {}
var _music := {}
var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _last := {}
var _a: AudioStreamPlayer
var _b: AudioStreamPlayer
var _current := ""
var _fade: Tween
var _amb := {}                  # name -> AudioStreamPlayer (looping, faded by level)
var _amb_target := {}           # name -> 0..1
var _engine: AudioStreamPlayer
var _engine_level := 0.0
var _engine_target := 0.0
var _frame := -1
var _started_this_frame := 0


func _ready() -> void:
	instance = self
	process_mode = Node.PROCESS_MODE_ALWAYS
	_make_buses()
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "Effects"
		add_child(p)
		_players.append(p)
	_a = AudioStreamPlayer.new()
	_b = AudioStreamPlayer.new()
	for p in [_a, _b]:
		p.bus = "Music"
		add_child(p)
	for n in SFX:
		var s := _load("res://audio/sfx/%s.ogg" % n)
		if s:
			_sfx[n] = s
	for n in AMBIENCE.keys():
		var p := AudioStreamPlayer.new()
		p.bus = "Ambience"
		p.stream = _looped(_load(AMBIENCE[n]))
		p.volume_db = -80.0
		add_child(p)
		_amb[n] = p
		_amb_target[n] = 0.0
	_engine = AudioStreamPlayer.new()
	_engine.bus = "Effects"
	_engine.stream = _looped(_load(ENGINE))
	_engine.volume_db = -80.0
	add_child(_engine)


func _exit_tree() -> void:
	if instance == self:
		instance = null


## Creates Music, Effects and Ambience buses under Master (once per run), and
## puts a gentle limiter on Master so stacked sounds never clip.
static func _make_buses() -> void:
	var m := AudioServer.get_bus_index("Master")
	var has_limiter := false
	for k in AudioServer.get_bus_effect_count(m):
		has_limiter = has_limiter or AudioServer.get_bus_effect(m, k) is AudioEffectHardLimiter
	if not has_limiter:
		var lim := AudioEffectHardLimiter.new()
		lim.ceiling_db = -1.0
		AudioServer.add_bus_effect(m, lim)
	for n in BUSES:
		if AudioServer.get_bus_index(n) == -1:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, n)
			AudioServer.set_bus_send(i, "Master")


## Imported resource if the editor has imported it, else the raw .ogg file.
static func _load(path: String) -> AudioStream:
	if ResourceLoader.exists(path):
		var s = load(path)
		if s is AudioStream:
			return s
	if FileAccess.file_exists(path):
		return AudioStreamOggVorbis.load_from_file(path)
	return null


static func _looped(s: AudioStream) -> AudioStream:
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = true
	return s


# ------------------------------------------------------------- static helpers

static func sfx(n: String, pitch := 1.0, volume_db := 0.0) -> void:
	if instance:
		instance.play(n, pitch, volume_db)


static func music(track: String) -> void:
	if instance:
		instance.play_music(track)


## Ambience mix: daytime town or night crickets, plus rain on top.
static func ambience(night: bool, rain: bool, on := true) -> void:
	if instance:
		instance._amb_target["day"] = 1.0 if on and not night else 0.0
		instance._amb_target["night"] = 1.0 if on and night else 0.0
		instance._amb_target["rain"] = 1.0 if on and rain else 0.0


## Engine hum: 0 = silent, 1 = a vehicle right under the camera.
static func engine(level: float) -> void:
	if instance:
		instance._engine_target = clampf(level, 0.0, 1.0)


# ------------------------------------------------------------- playback

func play(n: String, pitch := 1.0, volume_db := 0.0) -> void:
	if not _sfx.has(n):
		return
	var now := Time.get_ticks_msec()
	if now - int(_last.get(n, -1000)) < MIN_GAP_MS:
		return
	var f := Engine.get_process_frames()
	if f != _frame:
		_frame = f
		_started_this_frame = 0
	if _started_this_frame >= MAX_PER_FRAME:
		return
	_started_this_frame += 1
	_last[n] = now
	var p := _players[_next]
	_next = (_next + 1) % _players.size()
	p.stream = _sfx[n]
	p.pitch_scale = clampf(pitch, 0.25, 4.0)
	p.volume_db = volume_db
	p.play()


func play_music(track: String) -> void:
	if track == _current:
		return
	_current = track
	var stream: AudioStream = _music.get(track)
	if stream == null and MUSIC.has(track):
		stream = _looped(_load(MUSIC[track]))
		_music[track] = stream
	# Crossfade: the idle player takes the new track.
	var outgoing := _a
	var incoming := _b
	if _b.playing and not _a.playing:
		outgoing = _b
		incoming = _a
	_a = incoming
	_b = outgoing
	if _fade and _fade.is_valid():
		_fade.kill()          # a quick second switch must not stop the reused player
	var tw := create_tween()
	_fade = tw
	tw.set_parallel(true)
	if outgoing.playing:
		tw.tween_property(outgoing, "volume_db", -60.0, FADE)
	if stream != null:
		incoming.stream = stream
		incoming.volume_db = -60.0
		incoming.play()
		tw.tween_property(incoming, "volume_db", -4.0, FADE)
	tw.chain().tween_callback(outgoing.stop)


## Volumes are 0..1 per bus (Master, Music, Effects, Ambience).
func set_volumes(master: float, p_music: float, effects: float, amb: float) -> void:
	for pair in [["Master", master], ["Music", p_music], ["Effects", effects], ["Ambience", amb]]:
		var i := AudioServer.get_bus_index(pair[0])
		if i >= 0:
			AudioServer.set_bus_volume_db(i, linear_to_db(maxf(pair[1], 0.0001)))
			AudioServer.set_bus_mute(i, pair[1] <= 0.0)


func _process(delta: float) -> void:
	# Ambience and engine fade smoothly toward their targets.
	for n in _amb.keys():
		var p: AudioStreamPlayer = _amb[n]
		var target: float = _amb_target[n]
		var lin := db_to_linear(p.volume_db) if p.playing else 0.0
		lin = move_toward(lin, target * 0.8, delta * 0.4)
		if lin > 0.001:
			if not p.playing and p.stream:
				p.play()
			p.volume_db = linear_to_db(lin)
		elif p.playing:
			p.stop()
	_engine_level = move_toward(_engine_level, _engine_target, delta * 2.0)
	if _engine_level > 0.01 and _engine.stream:
		if not _engine.playing:
			_engine.play()
		_engine.volume_db = linear_to_db(_engine_level * 0.5)
		_engine.pitch_scale = 0.9 + 0.25 * _engine_level
	elif _engine.playing:
		_engine.stop()
